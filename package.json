{
  "name": "inbharat-ai-search",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "dev:vite": "vite",
    "dev:api": "tsx server/local-api.ts",
    "dev:local": "concurrently -n api,vite \"npm run dev:api\" \"npm run dev:vite:proxy\"",
    "dev:vite:proxy": "cross-env API_PROXY_TARGET=http://localhost:3001 vite",
    "prebuild": "tsx scripts/ci-checks.ts prebuild",
    "build": "npm run build:app",
    "postbuild": "tsx scripts/ci-checks.ts postbuild",
    "build:app": "vite build && tsx scripts/build-seo.ts && tsx scripts/sync-published-articles.ts",
    "ci:build": "tsx scripts/ci-checks.ts local",
    "test:ci": "tsx scripts/test-ci-checks.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:shell": "tsx scripts/verify-shell-crawl.ts",
    "build:vite-only": "vite build",
    "build:seo": "tsx scripts/build-seo.ts",
    "preview": "vite preview",
    "lint": "npm run lint:eslint && npm run typecheck && npm run audit:secrets && npm run test:ci",
    "lint:eslint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:growth": "tsx scripts/test-growth.ts",
    "test:e2e": "playwright test",
    "audit:secrets": "npm run test:secrets && tsx scripts/audit-secrets.ts",
    "test:secrets": "tsx scripts/test-audit-secrets.ts",
    "audit:seo": "tsx scripts/audit-seo.ts",
    "arcade": "cd agent-arcade && node scripts/dev-arcade-auto.mjs \"%CD%\"",
    "arcade:gateway": "cd agent-arcade && npm run dev:gateway",
    "arcade:web": "cd agent-arcade && npm run dev:web",
    "arcade:sim": "cd agent-arcade && npm run sim:human"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.2.0",
    "gsap": "^3.14.2",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.17.2",
    "motion": "^12.38.0",
    "openai": "^4.77.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.5",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/edge": "^1.3.3",
    "@vercel/node": "^12.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "express": "^5.2.1",
    "hast-util-to-html": "^9.0.5",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.28",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vercel": "^59.11.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
