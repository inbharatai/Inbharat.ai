{
  "name": "inbharat-ai-search",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "media:products": "tsx scripts/build-product-concept-media.ts",
    "media:unoone": "tsx scripts/build-unoone-media.ts",
    "media:all": "npm run media:products && npm run media:unoone",
    "predev": "npm run media:all",
    "predev:vite": "npm run media:all",
    "predev:vite:proxy": "npm run media:all",
    "prebuild:app": "npm run media:all",
    "prebuild:vite-only": "npm run media:all",
    "dev": "vercel dev",
    "dev:vite": "vite",
    "dev:api": "tsx server/local-api.ts",
    "dev:local": "concurrently -n api,vite \"npm run dev:api\" \"npm run dev:vite:proxy\"",
    "dev:vite:proxy": "cross-env API_PROXY_TARGET=http://localhost:3001 vite",
    "prebuild": "tsx scripts/ci-checks.ts prebuild",
    "build": "npm run build:app",
    "postbuild": "tsx scripts/ci-checks.ts postbuild",
    "build:app": "vite build && tsx scripts/build-seo.ts && tsx scripts/sync-published-articles.ts",
    "ci:build": "tsx scripts/ci-checks.ts local",
    "test:ci": "tsx scripts/test-ci-checks.ts",
    "test:seo-contract": "tsx scripts/test-seo-contract.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:shell": "tsx scripts/verify-shell-crawl.ts",
    "build:vite-only": "vite build",
    "build:seo": "tsx scripts/build-seo.ts",
    "preview": "vite preview",
    "lint": "npm run lint:eslint && npm run typecheck && npm run audit:secrets && npm run test:ci && npm run test:seo-contract && npm run test:seo-hardening",
    "lint:eslint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:growth": "tsx scripts/test-growth.ts",
    "test:e2e": "playwright test",
    "audit:secrets": "npm run test:secrets && tsx scripts/audit-secrets.ts",
    "test:secrets": "tsx scripts/test-audit-secrets.ts",
    "audit:seo": "tsx scripts/audit-seo.ts",
    "arcade": "cd agent-arcade && node scripts/dev-arcade-auto.mjs \"%CD%\"",
    "arcade:gateway": "cd agent-arcade && npm run dev:gateway",
    "arcade:web": "cd agent-arcade && npm run dev:web",
    "arcade:sim": "cd agent-arcade && npm run sim:human",
    "test:search-submission": "tsx scripts/test-search-submission.ts",
    "test:rendering-contract": "tsx scripts/test-rendering-contract.ts",
    "test:article-lifecycle": "tsx scripts/test-article-lifecycle.ts",
    "test:seo-audit-contracts": "tsx scripts/test-seo-audit-contracts.ts",
    "test:seo-hardening": "npm run test:search-submission && npm run test:rendering-contract && npm run test:article-lifecycle && npm run test:seo-audit-contracts && npm run test:article-display && npm run test:content-accuracy && npm run test:canonical-article-sync && npm run test:article-render-safety && npm run test:publication-read-models && npm run test:publication-sql && npm run test:locale-boundaries && npm run test:publication-cron-auth",
    "audit:deployment": "tsx scripts/audit-production-seo.ts",
    "test:article-display": "tsx scripts/test-article-display.ts",
    "test:content-accuracy": "tsx scripts/test-content-accuracy.mjs",
    "test:canonical-article-sync": "tsx scripts/test-canonical-article-sync.ts",
    "test:article-render-safety": "tsx scripts/test-article-render-safety.ts",
    "test:publication-read-models": "tsx scripts/test-publication-read-models.ts",
    "test:publication-sql": "node scripts/test-publication-sql.mjs",
    "test:locale-boundaries": "tsx scripts/test-locale-boundaries.tsx",
    "test:publication-cron-auth": "tsx scripts/test-publication-cron-auth.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.2.0",
    "gsap": "^3.14.2",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.17.2",
    "motion": "^12.38.0",
    "openai": "^6.49.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.5",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/edge": "^1.3.3",
    "@vercel/node": "^12.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "express": "^5.2.1",
    "hast-util-to-html": "^9.0.5",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.28",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vercel": "^59.11.2",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "dompurify": "3.4.18",
    "katex": "0.18.2",
    "undici": "7.30.2"
  }
}
