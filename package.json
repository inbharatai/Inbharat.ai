{
  "name": "inbharat-ai-search",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "dev:vite": "vite",
    "dev:api": "tsx server/local-api.ts",
    "dev:local": "concurrently -n api,vite \"npm run dev:api\" \"npm run dev:vite:proxy\"",
    "dev:vite:proxy": "cross-env API_PROXY_TARGET=http://localhost:3001 vite",
    "build": "vite build && tsx scripts/build-seo.ts",
    "build:vite-only": "vite build",
    "build:seo": "tsx scripts/build-seo.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test:growth": "tsx scripts/test-growth.ts",
    "test:e2e": "playwright test",
    "arcade": "cd agent-arcade && node scripts/dev-arcade-auto.mjs \"%CD%\"",
    "arcade:gateway": "cd agent-arcade && npm run dev:gateway",
    "arcade:web": "cd agent-arcade && npm run dev:web",
    "arcade:sim": "cd agent-arcade && npm run sim:human"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.2.0",
    "gsap": "^3.14.2",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.38.0",
    "openai": "^4.77.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.5",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.30.3",
    "remark-gfm": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/node": "^5.6.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "express": "^4.21.0",
    "hast-util-to-html": "^9.0.5",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vercel": "^50.18.2",
    "vite": "^6.2.0"
  }
}
