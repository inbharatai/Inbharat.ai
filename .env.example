# Copy to .env and fill in your keys. Never commit .env to Git.
# Get keys: OpenAI https://platform.openai.com/api-keys | Serper https://serper.dev | Supabase https://supabase.com

OPENAI_API_KEY=sk-your-openai-key-here
# SERPER_API_KEY=your-serper-key-here

# Supabase (client)
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=ey...
# Optional: exact redirect URL for password reset / email confirmation links (must match Supabase Redirect URLs)
# VITE_AUTH_REDIRECT_URL=https://inbharat.ai/app

# Supabase (server)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=ey...

# Local dev (no Vercel, no Supabase): use "npm run dev:local" — runs local API on :3001 + Vite with proxy.
# For chat you need OPENAI_API_KEY. For web search you need SERPER_API_KEY (optional).
# When using only "npm run dev:vite" and a deployed app, set:
# VITE_PROXY_API_TARGET=https://your-app.vercel.app
