# Copy this file to .env and fill in your keys. Do not commit .env.

# Required for chat, voice, and image generation
# Get key: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Required for sign-in (Email / Google)
# Get key: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: web search in Research mode
# Get key: https://serper.dev
SERPER_API_KEY=
