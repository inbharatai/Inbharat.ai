# InBharat AI — placeholders only. Copy to .env for local development.
# Never commit real .env/.env.local values. Configure hosted environments through
# secure project settings; do not copy production write keys into previews.
# VITE_* values enter the browser bundle: only public configuration belongs there.
# See README.md, DOCS.md and DEPLOY-STEPS.md for prerequisites and limitations.

# Browser Supabase client. Public anon key still requires correct database RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional email confirmation/password-reset redirect; default is current origin/app.
# Must match the Supabase redirect allowlist. Public URL only, never credentials.
# VITE_AUTH_REDIRECT_URL=http://localhost:5173/app

# Server Supabase client. Service-role key is secret and bypasses RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloud-backed web console (separate from the UnoOne on-device agent).
# Server-only. Set OpenAI for its chat/voice/image endpoints; Serper for live search.
OPENAI_API_KEY=
SERPER_API_KEY=

# Optional browser/build-time analytics. Leave unset to disable.
# Use a real GA4 measurement ID only in the intended environment; rebuild afterward.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Public Search Console HTML ownership-verification token, not an API credential.
GSC_SITE_VERIFICATION=

# Growth model path: Gemini only, independent of the web-console OpenAI key.
GEMINI_API_KEY=
# Comma-separated Supabase user IDs. app_metadata.role="admin" also grants access.
# There is no VITE_ admin-ID mirror; server authorization is authoritative.
GROWTH_ADMIN_USER_IDS=
# Fallback monthly model-spend cap; runtime growth_settings takes precedence.
GROWTH_MONTHLY_BUDGET_USD=20
# Optional Gemini model-name overrides. Defaults live in lib/growth/model-router.ts.
# Supported task suffixes: AUDIT, METADATA, SUMMARY, DRAFT, REVIEW, COVER,
# STRATEGY, CHAT, VISION, ARTICLE. No GROWTH_*_PROVIDER switch is implemented.
# GROWTH_DRAFT_MODEL=
# GROWTH_REVIEW_MODEL=
# GROWTH_COVER_MODEL=

# Required for authenticated scheduled execution (or use verified admin actions).
# Vercel sends Authorization: Bearer <CRON_SECRET> when configured.
# External callers may use x-cron-secret. A cron user-agent/header is not auth.
CRON_SECRET=

# Optional repository integration, server-only. Scope to intended repositories.
# Read for discovery; Contents write for article/cover commits. GH_TOKEN is fallback.
GITHUB_TOKEN=

# Optional contact mail. Use a verified sender and intended notification inbox.
RESEND_API_KEY=
RESEND_FROM=
CONTACT_NOTIFY_TO=
# Optional private salt for lead IP hashing.
GROWTH_LEAD_SALT=

# Optional social publishing; provider permissions/account eligibility still apply.
# See docs/social-publishing.md and the current channel implementation.
IG_USER_ID=
META_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Optional shared Google service account for GA4/GSC reports and permitted submission.
# Private key is secret; enter via secure settings (escaped \n newlines supported).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GA4_PROPERTY_ID=
GSC_SITE_URL=
# Example non-secret property shape: sc-domain:example.com or https://www.example.com
# Reporting roles do not automatically authorize sitemap submission.
# Legacy aliases, if used, take precedence in this order for BOTH reporting panels:
# GA4_CLIENT_EMAIL -> GSC_CLIENT_EMAIL -> GOOGLE_CLIENT_EMAIL
# GA4_PRIVATE_KEY -> GSC_PRIVATE_KEY -> GOOGLE_PRIVATE_KEY
# Prefer the shared pair above; do not mix unrelated alias identities and keys.
# GA4_CLIENT_EMAIL=
# GA4_PRIVATE_KEY=
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY=

# Local-only optional overrides. dev:local sets API_PROXY_TARGET to :3001.
# LOCAL_API_PORT is an explicit dev signal: NEVER set it in hosted production.
# LOCAL_API_PORT=3001
# API_PROXY_TARGET=http://localhost:3001

# Do not set platform provenance (VERCEL/VERCEL_ENV/VERCEL_GIT_COMMIT_SHA) by hand.
# Builds are publication-write-free. Automatic production reconciliation uses the
# existing CRON_SECRET and server Supabase pair only after both lifecycle/read-model
# migrations and canonical build eligibility are verified. It needs no VERCEL_TOKEN.
# Optional operator-only verification credentials are intentionally not templated here.

# Public sign-in UI is hidden while Supabase is intentionally inactive.
# This never disables server/admin authorization. Enable only after reactivation.
VITE_PUBLIC_LOGIN_ENABLED=false
