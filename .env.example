# ─────────────────────────────────────────────────────────────────────────────
# InBharat AI — Environment Variables Template
# Copy to .env and fill in your actual values.
# Set these SAME vars in Vercel dashboard → Settings → Environment Variables.
# NEVER commit .env to Git — add it to .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (REQUIRED — server-side only, never sent to browser) ───────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Supabase Client (REQUIRED) ───────────────────────────────────────────────
# Safe to expose — anon key is public by design (RLS enforces data security).
# Get from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Optional: exact redirect URL for password reset / email confirmation links
# Must match Supabase Redirect URLs in dashboard → Auth → URL Configuration
# VITE_AUTH_REDIRECT_URL=https://inbharat.ai/app

# ── Supabase Admin / Server (REQUIRED — server-side ONLY) ────────────────────
# ⚠️  Service role key bypasses RLS — NEVER expose to the browser
# Get from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Serper Web Search (OPTIONAL — enables live web search) ───────────────────
# Without this, Research/Browser modes answer from training data only.
# Get from: https://serper.dev (free tier: 2500 queries/month)
SERPER_API_KEY=

# ── Analytics (OPTIONAL — leave unset to disable) ─────────────────────────────
# Pluggable Google Analytics 4 hook. When set, the GA loader is injected
# client-side and page_view + custom events fire automatically.
# Get from: https://analytics.google.com/ → Admin → Data Streams → Measurement ID
# The CSP in vercel.json already allows googletagmanager.com + google-analytics.com,
# so setting this is a one-step flip — no second deploy for CSP. Nothing loads
# until this is set (no privacy/perf cost when unset).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console ownership verification token (build-time). Get from
# https://search.google.com/search-console → Add property → HTML tag → copy the
# content attribute only (not the full tag). When set, every built shell gets
# <meta name="google-site-verification" content="…"> so you can claim the site.
# GSC_SITE_VERIFICATION=

# ── Local Development ─────────────────────────────────────────────────────────
# For local dev WITHOUT Vercel CLI: use "npm run dev:local"
# Starts local API on :3001 + Vite with proxy. Needs OPENAI_API_KEY at minimum.
# For local dev WITH Vercel CLI: use "npm run dev" (recommended)

# ── InBharat Growth Agent (OPTIONAL — audit-only admin module) ───────────────
# All additive; everything degrades gracefully when unset. Server-side admin
# enforcement uses GROWTH_ADMIN_USER_IDS or a Supabase app_metadata role of
# "admin". The client UI gate uses the VITE_ mirror so the browser can hide
# the admin surface for non-admins (UI-only; the API still rejects).
# Comma-separated Supabase user ids (UUIDs).
GROWTH_ADMIN_USER_IDS=
VITE_GROWTH_ADMIN_USER_IDS=

# Shared secret for the /api/growth/cron/daily endpoint (header x-cron-secret).
CRON_SECRET=

# Monthly model spend cap in USD for the growth model router (Phase 5 drafts).
GROWTH_MONTHLY_BUDGET_USD=20

# Optional model overrides per task tier (defaults: audit/metadata/summary→
# gemini-flash-lite/flash, draft→gemini-flash, review→gpt-4.1-mini).
# GROWTH_AUDIT_MODEL=gemini-flash-lite-latest
# GROWTH_DRAFT_MODEL=gemini-flash-latest
# GROWTH_REVIEW_MODEL=gpt-4.1-mini
# GROWTH_AUDIT_PROVIDER=gemini
# GROWTH_DRAFT_PROVIDER=gemini
# GROWTH_REVIEW_PROVIDER=openai

# Growth-specific OpenAI key (falls back to OPENAI_API_KEY if unset). Kept
# separate from the chat backend so the chat model selection is never touched.
GROWTH_OPENAI_API_KEY=

# Gemini key for the growth model router (separate from chat).
GEMINI_API_KEY=

# GitHub PAT for Phase 3 PR creation (read-only for now; deferred). Server-only.
# GITHUB_TOKEN=ghp_...

# Google Analytics 4 (Data API) — service account. Server-only.
# GA4_CLIENT_EMAIL=growth@inbharat.iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GA4_PROPERTY_ID=123456789

# Google Search Console — service account. Server-only.
# GSC_CLIENT_EMAIL=growth@inbharat.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GSC_SITE_URL=https://inbharat.ai
